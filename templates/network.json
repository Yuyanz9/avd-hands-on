            "value": "[parameters('publicIpName')]"
          },
          "useNatGateway": {
            "value": true
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.42.1.51946",
              "templateHash": "12418390594403231656"
            }
          },
          "parameters": {
            "location": {
              "type": "string"
            },
            "vnetName": {
              "type": "string"
            },
            "vnetAddressPrefix": {
              "type": "string"
            },
            "cloudPcSubnetPrefix": {
              "type": "string"
            },
            "avdSubnetPrefix": {
              "type": "string"
            },
            "serverSubnetPrefix": {
              "type": "string"
