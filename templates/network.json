          },
          "variables": {
            "subnets": [
              {
                "name": "snet-cloudpc",
                "addressPrefix": "[parameters('cloudPcSubnetPrefix')]"
              },
              {
                "name": "snet-avd",
                "addressPrefix": "[parameters('avdSubnetPrefix')]"
              },
              {
                "name": "snet-server",
                "addressPrefix": "[parameters('serverSubnetPrefix')]"
              }
            ]
          },
          "resources": [
            {
              "condition": "[parameters('useNatGateway')]",
              "type": "Microsoft.Network/publicIPAddresses",
              "apiVersion": "2024-05-01",
              "name": "[parameters('publicIpName')]",
              "location": "[parameters('location')]",
              "sku": {
                "name": "Standard"
              },
              "properties": {
                "publicIPAllocationMethod": "Static",
                "publicIPAddressVersion": "IPv4"
              }
            },
            {
              "condition": "[parameters('useNatGateway')]",
              "type": "Microsoft.Network/natGateways",
              "apiVersion": "2024-05-01",
              "name": "[parameters('natGatewayName')]",
              "location": "[parameters('location')]",
              "sku": {
                "name": "Standard"
              },
              "properties": {
                "idleTimeoutInMinutes": 4,
                "publicIpAddresses": [
                  {
                    "id": "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIpName'))]"
                  }
                ]
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIpName'))]"
              ]
            },
            {
              "type": "Microsoft.Network/virtualNetworks",
              "apiVersion": "2024-05-01",
              "name": "[parameters('vnetName')]",
              "location": "[parameters('location')]",
              "properties": {
                "copy": [
                  {
                    "name": "subnets",
                    "count": "[length(variables('subnets'))]",
                    "input": {
                      "name": "[variables('subnets')[copyIndex('subnets')].name]",
                      "properties": "[union(createObject('addressPrefix', variables('subnets')[copyIndex('subnets')].addressPrefix, 'defaultOutboundAccess', not(parameters('useNatGateway')), 'privateEndpointNetworkPolicies', 'Disabled', 'privateLinkServiceNetworkPolicies', 'Enabled'), if(parameters('useNatGateway'), createObject('natGateway', createObject('id', resourceId('Microsoft.Network/natGateways', parameters('natGatewayName')))), createObject()))]"
                    }
                  }
                ],
                "addressSpace": {
                  "addressPrefixes": [
                    "[parameters('vnetAddressPrefix')]"
                  ]
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/natGateways', parameters('natGatewayName'))]"
              ]
            }
          ],
          "outputs": {
            "resourceGroupName": {
              "type": "string",
              "value": "[resourceGroup().name]"
            },
            "vnetId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName'))]"
            },
            "cloudPcSubnetId": {
              "type": "string",
              "value": "[format('{0}/subnets/snet-cloudpc', resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName')))]"
            },
            "avdSubnetId": {
              "type": "string",
              "value": "[format('{0}/subnets/snet-avd', resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName')))]"
